FRED_API_KEY=
# папка данных (БД, логи, exchange/); пусто — data_dir из config.yaml (по умолчанию ./data)
MACRO_DATA_DIR=
TG_API_ID=
TG_API_HASH=
TG_PHONE=
TG_BOT_TOKEN=
TG_CHAT_ID=
# webhook (фаза 14, webhook.enabled): адрес приёмника (может содержать токен) и необязательный ключ подписи HMAC
WEBHOOK_URL=
WEBHOOK_SECRET=
GIT_SSH_KEY_PATH=
# хост сервера для `make deploy` (фаза 6)
DEPLOY_HOST=
GEMINI_API_KEY=
# дашборд (macroctl serve): логин (по умолчанию macro) и пароль; без пароля — только 127.0.0.1
MACRO_DASHBOARD_USER=
MACRO_DASHBOARD_PASSWORD=
