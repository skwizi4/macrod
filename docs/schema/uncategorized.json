{
  "$defs": {
    "Header": {
      "additionalProperties": false,
      "properties": {
        "agent": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "generated_at": {
          "format": "date-time",
          "type": "string"
        },
        "iso_week": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "period": {
          "$ref": "#/$defs/Period"
        },
        "region": {
          "type": "string"
        },
        "schema_version": {
          "const": 1
        },
        "sources_failed": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "sources_ok": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "stale_series": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "region",
        "agent",
        "iso_week",
        "period",
        "generated_at",
        "kind",
        "sources_ok",
        "sources_failed",
        "stale_series",
        "title"
      ],
      "type": "object"
    },
    "NewsPost": {
      "additionalProperties": false,
      "properties": {
        "also": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "author": {
          "type": "string"
        },
        "published": {
          "format": "date-time",
          "type": "string"
        },
        "resonance": {
          "$ref": "#/$defs/Quantity"
        },
        "text": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "views": {
          "type": "integer"
        }
      },
      "required": [
        "published",
        "author",
        "views",
        "resonance",
        "text",
        "also",
        "url"
      ],
      "type": "object"
    },
    "Period": {
      "additionalProperties": false,
      "properties": {
        "from": {
          "format": "date-time",
          "type": "string"
        },
        "to": {
          "format": "date-time",
          "type": "string"
        },
        "tz": {
          "type": "string"
        }
      },
      "required": [
        "from",
        "to",
        "tz"
      ],
      "type": "object"
    },
    "Quantity": {
      "additionalProperties": false,
      "properties": {
        "unit": {
          "enum": [
            "percent",
            "bp",
            "pp",
            "usd_bn",
            "usd",
            "eur_bn",
            "eur",
            "thousands_persons",
            "count",
            "index",
            "ratio",
            "sigma",
            "moves_25bp",
            "correlation",
            "times"
          ],
          "type": "string"
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "unit",
        "value"
      ],
      "type": "object"
    },
    "UncategorizedReport": {
      "additionalProperties": false,
      "properties": {
        "header": {
          "$ref": "#/$defs/Header"
        },
        "posts": {
          "items": {
            "$ref": "#/$defs/NewsPost"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "required": [
        "header",
        "posts"
      ],
      "type": "object"
    }
  },
  "$ref": "#/$defs/UncategorizedReport",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "uncategorized"
}
