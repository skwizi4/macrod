{
  "$defs": {
    "BondAuction": {
      "additionalProperties": false,
      "properties": {
        "allotted": {
          "$ref": "#/$defs/Quantity"
        },
        "bids": {
          "$ref": "#/$defs/Quantity"
        },
        "btc": {
          "$ref": "#/$defs/Quantity"
        },
        "btc_dev": {
          "$ref": "#/$defs/Quantity"
        },
        "coupon": {
          "$ref": "#/$defs/Quantity"
        },
        "date": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "type": [
            "string",
            "null"
          ]
        },
        "isin": {
          "type": "string"
        },
        "multi_isin": {
          "type": "boolean"
        },
        "offered": {
          "$ref": "#/$defs/Quantity"
        },
        "previous": {
          "type": "integer"
        },
        "reopening": {
          "type": "boolean"
        },
        "retention": {
          "$ref": "#/$defs/Quantity"
        },
        "security": {
          "type": "string"
        },
        "term": {
          "type": "string"
        },
        "yield": {
          "$ref": "#/$defs/Quantity"
        },
        "yield_dev": {
          "$ref": "#/$defs/Quantity"
        }
      },
      "required": [
        "date",
        "security",
        "term",
        "isin",
        "reopening",
        "multi_isin",
        "coupon",
        "offered",
        "bids",
        "allotted",
        "retention",
        "yield",
        "yield_dev",
        "btc",
        "btc_dev",
        "previous"
      ],
      "type": "object"
    },
    "BondNext": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "format": "date-time",
          "type": "string"
        },
        "isin": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "at",
        "name",
        "isin"
      ],
      "type": "object"
    },
    "BondsReport": {
      "additionalProperties": false,
      "properties": {
        "auction_window": {
          "type": "integer"
        },
        "auctions": {
          "items": {
            "$ref": "#/$defs/BondAuction"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "curve": {
          "items": {
            "$ref": "#/$defs/ChangesRow"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "debt": {
          "items": {
            "$ref": "#/$defs/ChangesRow"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "header": {
          "$ref": "#/$defs/Header"
        },
        "missing": {
          "$ref": "#/$defs/MissingSection"
        },
        "monthly": {
          "items": {
            "$ref": "#/$defs/ChangesRow"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "next": {
          "items": {
            "$ref": "#/$defs/BondNext"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "released": {
          "items": {
            "$ref": "#/$defs/ReleaseRow"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "spreads": {
          "items": {
            "$ref": "#/$defs/ChangesRow"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "required": [
        "header",
        "released",
        "curve",
        "spreads",
        "monthly",
        "debt",
        "auction_window",
        "auctions",
        "next",
        "missing"
      ],
      "type": "object"
    },
    "ChangesRow": {
      "additionalProperties": false,
      "properties": {
        "change_1w": {
          "$ref": "#/$defs/Quantity"
        },
        "change_4w": {
          "$ref": "#/$defs/Quantity"
        },
        "date": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "type": [
            "string",
            "null"
          ]
        },
        "flags": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "freq": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "index",
            "rate",
            "pct",
            "bn",
            "thous",
            "count",
            "usd",
            "ratio",
            "bp",
            "px",
            "usd0",
            "bn_eur",
            "eur",
            "fx"
          ],
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "level": {
          "$ref": "#/$defs/Quantity"
        },
        "quality": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "z": {
          "$ref": "#/$defs/Quantity"
        }
      },
      "required": [
        "id",
        "source",
        "label",
        "date",
        "freq",
        "kind",
        "flags",
        "quality",
        "level",
        "change_1w",
        "change_4w",
        "z"
      ],
      "type": "object"
    },
    "FactValue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string"
        },
        "current": {
          "$ref": "#/$defs/Quantity"
        },
        "previous": {
          "$ref": "#/$defs/Quantity"
        },
        "previous_first": {
          "$ref": "#/$defs/Quantity"
        }
      },
      "required": [
        "code",
        "current",
        "previous",
        "previous_first"
      ],
      "type": "object"
    },
    "Header": {
      "additionalProperties": false,
      "properties": {
        "agent": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "generated_at": {
          "format": "date-time",
          "type": "string"
        },
        "iso_week": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "period": {
          "$ref": "#/$defs/Period"
        },
        "region": {
          "type": "string"
        },
        "schema_version": {
          "const": 1
        },
        "sources_failed": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "sources_ok": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "stale_series": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "region",
        "agent",
        "iso_week",
        "period",
        "generated_at",
        "kind",
        "sources_ok",
        "sources_failed",
        "stale_series",
        "title"
      ],
      "type": "object"
    },
    "MissingSection": {
      "additionalProperties": false,
      "properties": {
        "failures": {
          "items": {
            "$ref": "#/$defs/SourceFailure"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "stale": {
          "items": {
            "$ref": "#/$defs/StaleSeries"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "required": [
        "stale",
        "failures"
      ],
      "type": "object"
    },
    "Period": {
      "additionalProperties": false,
      "properties": {
        "from": {
          "format": "date-time",
          "type": "string"
        },
        "to": {
          "format": "date-time",
          "type": "string"
        },
        "tz": {
          "type": "string"
        }
      },
      "required": [
        "from",
        "to",
        "tz"
      ],
      "type": "object"
    },
    "Quantity": {
      "additionalProperties": false,
      "properties": {
        "unit": {
          "enum": [
            "percent",
            "bp",
            "pp",
            "usd_bn",
            "usd",
            "eur_bn",
            "eur",
            "thousands_persons",
            "count",
            "index",
            "ratio",
            "sigma",
            "moves_25bp",
            "correlation",
            "times"
          ],
          "type": "string"
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "unit",
        "value"
      ],
      "type": "object"
    },
    "ReleaseRow": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "format": "date-time",
          "type": "string"
        },
        "fact": {
          "items": {
            "$ref": "#/$defs/FactValue"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "has_previous": {
          "type": "boolean"
        },
        "kind": {
          "enum": [
            "index",
            "rate",
            "pct",
            "bn",
            "thous",
            "count",
            "usd",
            "ratio",
            "bp",
            "px",
            "usd0",
            "bn_eur",
            "eur",
            "fx"
          ],
          "type": "string"
        },
        "level_change": {
          "$ref": "#/$defs/Quantity"
        },
        "name": {
          "type": "string"
        },
        "revised": {
          "type": "boolean"
        },
        "saar": {
          "type": "boolean"
        },
        "series_id": {
          "type": "string"
        },
        "timed": {
          "type": "boolean"
        }
      },
      "required": [
        "at",
        "timed",
        "name",
        "series_id",
        "kind",
        "saar",
        "fact",
        "has_previous",
        "revised",
        "level_change"
      ],
      "type": "object"
    },
    "SourceFailure": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "since": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "key",
        "since",
        "error"
      ],
      "type": "object"
    },
    "StaleSeries": {
      "additionalProperties": false,
      "properties": {
        "freq": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "last_obs": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "type": [
            "string",
            "null"
          ]
        },
        "next_date": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "type": [
            "string",
            "null"
          ]
        },
        "next_release": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "last_obs",
        "freq",
        "next_release",
        "next_date"
      ],
      "type": "object"
    }
  },
  "$ref": "#/$defs/BondsReport",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fiscal_bonds"
}
